<Window x:Class="FSLTool.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:FSLTool.Localization"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource Text}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True">
    <!-- outer margin leaves room for the shadow -->
    <Border Margin="18" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="1"
            CornerRadius="24" MinWidth="400" MaxWidth="580">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.28" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header (drag to move) -->
            <Grid x:Name="Header" Margin="20,18,12,0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="17" FontWeight="SemiBold" Margin="14,9,8,0"
                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" Width="32" Height="32" Padding="0" VerticalAlignment="Top"
                        Click="Cancel_Click" IsCancel="True" ToolTip="{l:Tr Dialog.CloseEsc}"/>
            </Grid>

            <!-- message -->
            <StackPanel Grid.Row="1" Margin="74,6,26,0">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource Text}"/>
                </ScrollViewer>
                <!-- optional input (Dialog.Prompt) -->
                <TextBox x:Name="InputBox" Margin="0,12,0,0" Visibility="Collapsed" MinWidth="300"/>
            </StackPanel>

            <!-- buttons -->
            <Border Grid.Row="2" Margin="0,20,0,0" Padding="20,14" Background="{DynamicResource Surface2}" CornerRadius="0,0,24,24">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton" MinWidth="110" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="YesButton" MinWidth="110" Click="Ok_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
