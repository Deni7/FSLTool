<Window x:Class="FSLTool.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- outer margin leaves room for the shadow -->
    <Border Margin="18" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
            CornerRadius="12" MinWidth="380" MaxWidth="560">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.55" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header (drag to move) -->
            <Grid x:Name="Header" Margin="20,18,12,0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBadge" Width="32" Height="32" CornerRadius="16" VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" FontSize="17" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                </Border>
                <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" Margin="12,5,8,0"
                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" Padding="8,2" VerticalAlignment="Top"
                        Click="Cancel_Click" IsCancel="True" ToolTip="Закрити (Esc)"/>
            </Grid>

            <!-- message -->
            <StackPanel Grid.Row="1" Margin="64,8,24,0">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource Text}"/>
                </ScrollViewer>
                <!-- optional input (Dialog.Prompt) -->
                <TextBox x:Name="InputBox" Margin="0,12,0,0" Visibility="Collapsed" MinWidth="300"/>
            </StackPanel>

            <!-- buttons -->
            <Border Grid.Row="2" Margin="0,20,0,0" Padding="20,14" Background="{StaticResource Bg}" CornerRadius="0,0,12,12"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="NoButton" MinWidth="110" Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button x:Name="YesButton" MinWidth="110" Click="Ok_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
