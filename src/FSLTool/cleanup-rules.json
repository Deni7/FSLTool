{
  "_help": [
    "Правила очищення FSLogix-контейнерів. Файл перечитується кнопкою 'Перечитати правила'.",
    "paths      — шляхи ВІДНОСНО кореневої папки контейнера (Profile або ODFC всередині VHDX).",
    "             Префікс '$volume\\' — шлях відносно кореня тому VHDX (напр. $RECYCLE.BIN).",
    "             Підтримуються маски в сегментах: '*', '?', а також '**' = будь-яка глибина.",
    "action     — DeleteContents: видалити вміст папки (сама папка лишається);",
    "             DeleteFolder:   видалити папку повністю;",
    "             DeleteFiles:    видалити лише файли за масками include у цій папці (без підпапок).",
    "include    — маски файлів (для DeleteContents/DeleteFiles). За замовчуванням ['*'].",
    "exclude    — маски файлів/папок, які НІКОЛИ не видаляються цим правилом.",
    "olderThanDays — видаляти лише файли, старіші за N днів (0 = всі).",
    "containers — до яких контейнерів застосовувати: Profile, ODFC або Any.",
    "names      — необов'язкові назви правила іншими мовами для інтерфейсу: { \"en\": \"...\" } (інакше показується name).",
    "Точки повторного розбору (junction/symlink) ніколи не обходяться — видаляється лише сам лінк."
  ],
  "globalExclude": [ "desktop.ini", "NTUSER.DAT*", "UsrClass.dat*" ],
  "rules": [
    {
      "name": "Тимчасові файли (Temp)",
      "names": { "en": "Temporary files (Temp)" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [ "AppData\\Local\\Temp" ],
      "action": "DeleteContents",
      "olderThanDays": 0
    },
    {
      "name": "Кеш Internet / WebCache",
      "names": { "en": "Internet cache / WebCache" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [
        "AppData\\Local\\Microsoft\\Windows\\INetCache",
        "AppData\\Local\\Microsoft\\Windows\\WebCache.old"
      ],
      "action": "DeleteContents"
    },
    {
      "name": "Звіти про помилки та дампи",
      "names": { "en": "Error reports and dumps" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [
        "AppData\\Local\\Microsoft\\Windows\\WER",
        "AppData\\Local\\CrashDumps",
        "AppData\\Local\\D3DSCache"
      ],
      "action": "DeleteContents"
    },
    {
      "name": "Кеш мініатюр Explorer",
      "names": { "en": "Explorer thumbnail cache" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [ "AppData\\Local\\Microsoft\\Windows\\Explorer" ],
      "action": "DeleteFiles",
      "include": [ "thumbcache_*.db", "iconcache_*.db" ]
    },
    {
      "name": "Google Chrome — кеш",
      "names": { "en": "Google Chrome — cache" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [
        "AppData\\Local\\Google\\Chrome\\User Data\\*\\Cache",
        "AppData\\Local\\Google\\Chrome\\User Data\\*\\Code Cache",
        "AppData\\Local\\Google\\Chrome\\User Data\\*\\GPUCache",
        "AppData\\Local\\Google\\Chrome\\User Data\\*\\Service Worker\\CacheStorage",
        "AppData\\Local\\Google\\Chrome\\User Data\\*\\Service Worker\\ScriptCache",
        "AppData\\Local\\Google\\Chrome\\User Data\\ShaderCache",
        "AppData\\Local\\Google\\Chrome\\User Data\\GrShaderCache"
      ],
      "action": "DeleteContents"
    },
    {
      "name": "Microsoft Edge — кеш",
      "names": { "en": "Microsoft Edge — cache" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [
        "AppData\\Local\\Microsoft\\Edge\\User Data\\*\\Cache",
        "AppData\\Local\\Microsoft\\Edge\\User Data\\*\\Code Cache",
        "AppData\\Local\\Microsoft\\Edge\\User Data\\*\\GPUCache",
        "AppData\\Local\\Microsoft\\Edge\\User Data\\*\\Service Worker\\CacheStorage",
        "AppData\\Local\\Microsoft\\Edge\\User Data\\*\\Service Worker\\ScriptCache",
        "AppData\\Local\\Microsoft\\Edge\\User Data\\ShaderCache",
        "AppData\\Local\\Microsoft\\Edge\\User Data\\GrShaderCache"
      ],
      "action": "DeleteContents"
    },
    {
      "name": "Mozilla Firefox — кеш",
      "names": { "en": "Mozilla Firefox — cache" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [
        "AppData\\Local\\Mozilla\\Firefox\\Profiles\\*\\cache2",
        "AppData\\Local\\Mozilla\\Firefox\\Profiles\\*\\startupCache"
      ],
      "action": "DeleteContents"
    },
    {
      "name": "Microsoft Teams (classic) — кеш",
      "names": { "en": "Microsoft Teams (classic) — cache" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [
        "AppData\\Roaming\\Microsoft\\Teams\\Cache",
        "AppData\\Roaming\\Microsoft\\Teams\\Code Cache",
        "AppData\\Roaming\\Microsoft\\Teams\\GPUCache",
        "AppData\\Roaming\\Microsoft\\Teams\\blob_storage",
        "AppData\\Roaming\\Microsoft\\Teams\\tmp",
        "AppData\\Roaming\\Microsoft\\Teams\\Service Worker\\CacheStorage"
      ],
      "action": "DeleteContents"
    },
    {
      "name": "Microsoft Teams (new) — кеш WebView",
      "names": { "en": "Microsoft Teams (new) — WebView cache" },
      "enabled": true,
      "containers": [ "Profile" ],
      "paths": [
        "AppData\\Local\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\*\\Cache",
        "AppData\\Local\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\*\\Code Cache",
        "AppData\\Local\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\*\\GPUCache"
      ],
      "action": "DeleteContents"
    },
    {
      "name": "Кошик користувача",
      "names": { "en": "User's Recycle Bin" },
      "enabled": true,
      "containers": [ "Any" ],
      "paths": [ "$volume\\$RECYCLE.BIN" ],
      "action": "DeleteContents"
    },
    {
      "name": "Завантаження старші за 180 днів (вимкнено)",
      "names": { "en": "Downloads older than 180 days (disabled)" },
      "enabled": false,
      "containers": [ "Profile" ],
      "paths": [ "Downloads" ],
      "action": "DeleteContents",
      "olderThanDays": 180
    }
  ]
}
