<Window x:Class="FSLTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FSLTool.ViewModels"
        xmlns:v="clr-namespace:FSLTool.Views"
        xmlns:l="clr-namespace:FSLTool.Localization"
        Title="FSLTool — FSLogix Profile Manager"
        Icon="pack://application:,,,/FSLTool;component/Assets/app.ico"
        Width="1480" Height="900" MinWidth="1180" MinHeight="680"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- header tabs «Контейнери» / «Налаштування» -->
        <Style x:Key="NavTab" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="v:Ui.CornerRadius" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- stat card: lights up (Primary) when its filter (Tag) is the active one -->
        <Style x:Key="FilterCard" TargetType="Button" BasedOn="{StaticResource StatCard}">
            <Setter Property="v:Ui.Accent" Value="{DynamicResource Text}"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource FilterMatch}">
                            <Binding Path="Filter"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{DynamicResource Primary}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
                    <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
                    <Setter Property="v:Ui.Accent" Value="{DynamicResource OnPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FilterCardCrit" TargetType="Button" BasedOn="{StaticResource FilterCard}">
            <Setter Property="v:Ui.Accent" Value="{DynamicResource CritText}"/>
        </Style>
        <Style x:Key="FilterCardMount" TargetType="Button" BasedOn="{StaticResource FilterCard}">
            <Setter Property="v:Ui.Accent" Value="{DynamicResource MountText}"/>
        </Style>
        <Style x:Key="FilterCardAccent" TargetType="Button" BasedOn="{StaticResource FilterCard}">
            <Setter Property="v:Ui.Accent" Value="{DynamicResource Accent}"/>
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="Margin" Value="0,4,36,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <Style x:Key="StatNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Foreground" Value="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
        <Style x:Key="StatSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
        <!-- icon in a tinted circle, both in the card's accent colour -->
        <Style x:Key="StatIcon" TargetType="Grid">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <!-- secondary line of a hero action row -->
        <Style x:Key="ActionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Opacity" Value="0.78"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="ActionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- label / value rows of the details card -->
        <Style x:Key="KvLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,10,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="KvValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>

        <!-- − value + stepper of the thresholds -->
        <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="v:Ui.CornerRadius" Value="18"/>
            <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
        </Style>
        <Style x:Key="StepBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24,10,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="*"/>      <!-- page -->
            <RowDefinition Height="Auto"/>   <!-- log -->
            <RowDefinition Height="Auto"/>   <!-- status -->
        </Grid.RowDefinitions>

        <!-- ═════════════════════════ HEADER ═════════════════════════ -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border HorizontalAlignment="Left" Height="44" Padding="7,0,18,0" CornerRadius="22"
                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Image Width="30" Height="30" Source="pack://application:,,,/FSLTool;component/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="FSLTool" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,1" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="4" CornerRadius="24" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{l:Tr Main.Nav.Containers}" Command="{Binding ShowPageCommand}" CommandParameter="containers">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsContainersPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Primary}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{l:Tr Main.Nav.Settings}" Command="{Binding ShowPageCommand}" CommandParameter="settings" Margin="4,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavTab}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSettingsPage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Primary}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource OnPrimary}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- log: badge = warnings / errors since it was last opened -->
                <Button Command="{Binding ToggleLogCommand}" ToolTip="{l:Tr Main.Header.LogTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLogOpen}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.List}"/>
                        <TextBlock Text="{l:Tr Main.Header.Log}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        <Border Margin="8,0,0,0" MinWidth="20" Height="20" CornerRadius="10" Padding="6,0" Background="{DynamicResource WarnSoft}"
                                Visibility="{Binding LogAlertCount, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding LogAlertCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Button>
                <Button x:Name="LangButton" Style="{StaticResource PillButton}" Margin="8,0,0,0" Padding="14,0" Click="Language_Click"
                        ToolTip="{l:Tr Main.Header.LangTip}" AutomationProperties.Name="{l:Tr Lang.Label}">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Globe}"/>
                        <TextBlock Text="{Binding LanguageCode}" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Command="{Binding ToggleThemeCommand}" ToolTip="{l:Tr Main.Header.ThemeTip}"
                        AutomationProperties.Name="{l:Tr Main.Header.ThemeTip}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RoundPillButton}">
                            <Setter Property="Tag" Value="{StaticResource I.Moon}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDark}" Value="True">
                                    <Setter Property="Tag" Value="{StaticResource I.Sun}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <ContentControl Style="{StaticResource Ic}" Width="18" Height="18"
                                    Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <Button Style="{StaticResource RoundPillButton}" Margin="8,0,0,0" Click="Help_Click"
                        ToolTip="{l:Tr Main.Sidebar.Help}" AutomationProperties.Name="{l:Tr Main.Sidebar.Help}">
                    <ContentControl Style="{StaticResource Ic}" Width="18" Height="18" Tag="{StaticResource I.Help}"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═════════════════════════ PAGE: CONTAINERS ═════════════════════════ -->
        <Grid Grid.Row="1" Visibility="{Binding IsContainersPage, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- title + storage of every profile path -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Bottom" Margin="0,0,24,0">
                    <TextBlock Text="{l:Tr Main.Hero.Title}" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="{Binding HeroSummary}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <DockPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="14,0,0,4" VerticalAlignment="Bottom"
                            BorderBrush="{DynamicResource Neutral}" BorderThickness="1"
                            Command="{Binding ShowPageCommand}" CommandParameter="settings"
                            ToolTip="{l:Tr Main.Hero.AddPathTip}" AutomationProperties.Name="{l:Tr Main.Hero.AddPathTip}">
                        <ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Plus}"/>
                    </Button>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Paths}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="230" Margin="18,0,0,0" ToolTip="{Binding SpaceText}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsedPercent, StringFormat='{}{0:0} %'}" FontSize="12"
                                                       FontWeight="SemiBold" Margin="8,0,0,0"
                                                       Foreground="{Binding Severity, Converter={StaticResource SevBrush}, ConverterParameter=text}"
                                                       Visibility="{Binding HasSpace, Converter={StaticResource Vis}}"/>
                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="11.5" Foreground="{DynamicResource Muted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <Border Style="{StaticResource BarTrack}" Height="10" CornerRadius="5" Margin="0,6,0,5"
                                                Visibility="{Binding HasSpace, Converter={StaticResource Vis}}">
                                            <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="5" RenderTransformOrigin="0,0">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding UsedPercent, Converter={StaticResource Scale}}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                        <TextBlock x:Name="space" Text="{Binding SpaceText}" Style="{StaticResource MutedText}" FontSize="11.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                            <Setter TargetName="space" Property="Foreground" Value="{DynamicResource CritText}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter TargetName="space" Property="Foreground" Value="{DynamicResource WarnText}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Grid>

            <!-- stat cards = quick filters (click again to reset) -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,-12,16">
                <Button Tag="All" Style="{StaticResource FilterCard}" Margin="0,0,12,0" Command="{Binding SetFilterCommand}" CommandParameter="All">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Main.Card.Total}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatNum}"/>
                            <TextBlock Text="{Binding TotalSize}" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                        <Grid Style="{StaticResource StatIcon}">
                            <Ellipse Fill="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.13"/>
                            <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Drive}" HorizontalAlignment="Center"
                                            Foreground="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button Tag="Problem" Style="{StaticResource FilterCardCrit}" Margin="0,0,12,0" Command="{Binding SetFilterCommand}" CommandParameter="Problem">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Main.Card.Overfull}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding CriticalCount}" Style="{StaticResource StatNum}"/>
                            <TextBlock Style="{StaticResource StatSub}">
                                <Run Text="+"/><Run Text="{Binding WarningCount, Mode=OneWay}" FontWeight="Bold"/><Run Text="{l:Tr Main.Card.NearLimit}"/>
                            </TextBlock>
                        </StackPanel>
                        <Grid Style="{StaticResource StatIcon}">
                            <Ellipse Fill="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.13"/>
                            <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Alert}" HorizontalAlignment="Center"
                                            Foreground="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button Tag="Mounted" Style="{StaticResource FilterCardMount}" Margin="0,0,12,0" Command="{Binding SetFilterCommand}" CommandParameter="Mounted">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Main.Card.Mounted}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding MountedCount}" Style="{StaticResource StatNum}"/>
                            <TextBlock Text="{l:Tr Main.Card.ActiveSessions}" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                        <Grid Style="{StaticResource StatIcon}">
                            <Ellipse Fill="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.13"/>
                            <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Plug}" HorizontalAlignment="Center"
                                            Foreground="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button Tag="Orphan" Style="{StaticResource FilterCard}" Margin="0,0,12,0" Command="{Binding SetFilterCommand}" CommandParameter="Orphan">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Main.Card.Orphans}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding OrphanCount}" Style="{StaticResource StatNum}"/>
                            <TextBlock Text="{l:Tr Main.Card.OrphanSize, Arg={Binding OrphanSize}}" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                        <Grid Style="{StaticResource StatIcon}">
                            <Ellipse Fill="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.13"/>
                            <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Orphan}" HorizontalAlignment="Center"
                                            Foreground="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button Tag="Disabled" Style="{StaticResource FilterCard}" Margin="0,0,12,0" Command="{Binding SetFilterCommand}" CommandParameter="Disabled"
                        ToolTip="{l:Tr Main.Card.DisabledTip}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Main.Card.Disabled}" Style="{StaticResource StatLabel}" ToolTip="{x:Null}"/>
                            <TextBlock Text="{Binding DisabledCount}" Style="{StaticResource StatNum}"/>
                            <TextBlock Text="{Binding DisabledSize}" Style="{StaticResource StatSub}" ToolTip="{x:Null}"/>
                        </StackPanel>
                        <Grid Style="{StaticResource StatIcon}">
                            <Ellipse Fill="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.13"/>
                            <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.UserOff}" HorizontalAlignment="Center"
                                            Foreground="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button Tag="Stale" Style="{StaticResource FilterCard}" Margin="0,0,12,0" Command="{Binding SetFilterCommand}" CommandParameter="Stale">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Main.Card.Stale}" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding StaleCount}" Style="{StaticResource StatNum}"/>
                            <TextBlock Text="{l:Tr Main.Card.StaleHint, Arg={Binding Settings.StaleDays}}" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                        <Grid Style="{StaticResource StatIcon}">
                            <Ellipse Fill="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.13"/>
                            <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Clock}" HorizontalAlignment="Center"
                                            Foreground="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
                <Button Tag="Compactable" Style="{StaticResource FilterCardAccent}" Margin="0,0,12,0" Command="{Binding SetFilterCommand}" CommandParameter="Compactable"
                        ToolTip="{Binding CompactableTip}">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{l:Tr Main.Card.Compactable}" Style="{StaticResource StatLabel}" ToolTip="{x:Null}"/>
                            <TextBlock Text="{Binding CompactableCount}" Style="{StaticResource StatNum}"/>
                            <TextBlock Text="{Binding CompactableHint}" Style="{StaticResource StatSub}" ToolTip="{x:Null}"/>
                        </StackPanel>
                        <Grid Style="{StaticResource StatIcon}">
                            <Ellipse Fill="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}" Opacity="0.13"/>
                            <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Compress}" HorizontalAlignment="Center"
                                            Foreground="{Binding (v:Ui.Accent), RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Grid>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- table + details -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <!-- narrowest width at which the details do not clip (two-column buttons, label / value rows) -->
                    <ColumnDefinition Width="368"/>
                </Grid.ColumnDefinitions>

                <!-- ───────── table card ───────── -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- toolbar -->
                        <DockPanel Margin="16,14,16,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <!-- split button: main action refreshes visible rows, ▾ opens the other variants -->
                                <Border CornerRadius="20" BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Command="{Binding RefreshVisibleCommand}" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Text}"
                                                Padding="14,0,10,0" Height="38" v:Ui.CornerRadius="19,0,0,19" ToolTip="{l:Tr Main.RefreshVisibleTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Refresh}"/>
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="{l:Tr Main.RefreshVisibleButton}"/><Run Text="{Binding VisibleCount, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{DynamicResource Muted}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Button>
                                        <Border Width="1" Height="22" Background="{DynamicResource Line}"/>
                                        <Button x:Name="RefreshMenuButton" Style="{StaticResource GhostButton}" Foreground="{DynamicResource Text}"
                                                Width="36" Height="38" Padding="0" v:Ui.CornerRadius="0,19,19,0" Click="RefreshMenu_Click"
                                                ToolTip="{l:Tr Main.RefreshMenuTip}" AutomationProperties.Name="{l:Tr Main.RefreshMenuTip}">
                                            <ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.ChevronDown}"/>
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Command="{Binding RefreshVisibleCommand}">
                                                        <MenuItem.Header>
                                                            <TextBlock Text="{l:Tr Main.RefreshMenu.Visible, Arg={Binding VisibleCount}}"/>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding RefreshCheckedCommand}">
                                                        <MenuItem.Header>
                                                            <TextBlock Text="{l:Tr Main.RefreshMenu.Checked, Arg={Binding CheckedCount}}"/>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding RefreshAllCommand}">
                                                        <MenuItem.Header>
                                                            <TextBlock Text="{l:Tr Main.RefreshMenu.All, Arg={Binding TotalCount}}"/>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}" Height="40" Padding="18,0">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Refresh}"/>
                                        <TextBlock Text="{l:Tr Main.Scan}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource IconTextBox}" Width="340" v:Ui.Icon="{StaticResource I.Search}"
                                         v:Ui.Placeholder="{l:Tr Main.SearchHint}" AutomationProperties.Name="{l:Tr Main.SearchHint}"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                                <!-- custom filter: any condition over any property, groups І / АБО / НЕ, saved filters (Ctrl+Shift+F) -->
                                <Button Margin="8,0,0,0" Height="40" Padding="14,0" Click="CustomFilter_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BaseButton}">
                                            <Setter Property="ToolTip" Value="{l:Tr Main.CustomFilterTip}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomFilterActive}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                                                    <Setter Property="ToolTip" Value="{Binding CustomFilterText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Filter}"/>
                                        <TextBlock Text="{l:Tr Main.FilterButton}" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <Border Margin="8,0,0,0" MinWidth="20" Height="20" CornerRadius="10" Padding="6,0" Background="{DynamicResource Accent}"
                                                Visibility="{Binding CustomFilterCount, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding CustomFilterCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OnPrimary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>

                        <!-- active filters (stat card, custom filter) + check helpers -->
                        <DockPanel Grid.Row="1" Margin="16,0,12,8" MinHeight="30">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Text="{l:Tr Main.CheckedCount, Arg={Binding CheckedCount}}"/>
                                <Button Content="{l:Tr Main.CheckVisible}" Style="{StaticResource LinkButton}" Command="{Binding CheckAllCommand}" CommandParameter="1"/>
                                <Button Content="{l:Tr Main.Uncheck}" Style="{StaticResource GhostButton}" Command="{Binding CheckAllCommand}" CommandParameter="0"/>
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <!-- filter set by a stat card -->
                                <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentSoft}" Padding="10,0,4,0" Height="28" CornerRadius="14"
                                        Margin="0,0,8,0" Visibility="{Binding IsFiltered, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding FilterLabel}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12.5"
                                                   VerticalAlignment="Center"/>
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Margin="4,0,0,0" Foreground="{DynamicResource AccentText}"
                                                Command="{Binding SetFilterCommand}" CommandParameter="All"
                                                ToolTip="{l:Tr Main.FilterBar.ResetTip}" AutomationProperties.Name="{l:Tr Main.FilterBar.ResetTip}">
                                            <ContentControl Style="{StaticResource Ic}" Width="11" Height="11" Tag="{StaticResource I.X}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <!-- custom filter in words (button «Фільтр») -->
                                <Border Style="{StaticResource Chip}" Padding="4,0,4,0" Height="28" CornerRadius="14" Margin="0,0,8,0"
                                        Visibility="{Binding IsCustomFilterActive, Converter={StaticResource Vis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Padding="6,0" Height="24" Click="CustomFilter_Click" ToolTip="{Binding CustomFilterText}"
                                                Foreground="{DynamicResource NeutralText}">
                                            <TextBlock Text="{Binding CustomFilterText}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="22" Height="22" Foreground="{DynamicResource NeutralText}"
                                                Command="{Binding ClearCustomFilterCommand}"
                                                ToolTip="{l:Tr Main.ResetCustomFilter}" AutomationProperties.Name="{l:Tr Main.ResetCustomFilter}">
                                            <ContentControl Style="{StaticResource Ic}" Width="11" Height="11" Tag="{StaticResource I.X}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource MutedText}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Text="{l:Tr Main.FilterBar.Shown, Arg={Binding VisibleCount}, Arg2={Binding TotalCount}}"/>
                                <!-- "worth compacting" ⇄ "not measured yet": what to compact, and what to measure first -->
                                <Button Style="{StaticResource LinkButton}" Command="{Binding SetFilterCommand}" CommandParameter="Unmeasured"
                                        Visibility="{Binding ShowUnmeasuredLink, Converter={StaticResource Vis}}"
                                        ToolTip="{l:Tr Main.FilterBar.UnmeasuredTip}"
                                        Content="{l:Tr Main.FilterBar.Unmeasured, Arg={Binding UnmeasuredCount}}"/>
                                <Button Style="{StaticResource LinkButton}" Command="{Binding SetFilterCommand}" CommandParameter="Compactable"
                                        Visibility="{Binding ShowCompactableLink, Converter={StaticResource Vis}}"
                                        Content="{l:Tr Main.FilterBar.BackToCompactable}"/>
                            </WrapPanel>
                        </DockPanel>

                        <!-- profiles grid (rounded strip behind the column headers) -->
                        <Grid Grid.Row="2" Margin="8,0,8,8">
                            <Border Height="34" VerticalAlignment="Top" CornerRadius="12" Background="{DynamicResource Surface2}"/>
                            <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" Sorting="Grid_Sorting">
                                <DataGrid.Columns>
                                    <!-- sortable by the check mark: first click puts checked rows on top (see Grid_Sorting) -->
                                    <DataGridTemplateColumn Width="44" SortMemberPath="IsChecked">
                                        <DataGridTemplateColumn.Header>
                                            <ContentControl Style="{StaticResource Ic}" Width="13" Height="13" Tag="{StaticResource I.Check}"
                                                            ToolTip="{l:Tr Main.Grid.CheckSortTip}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- each row has two lines: the main value above, details below -->
                                    <DataGridTemplateColumn Header="{l:Tr Main.Grid.User}" Width="2.2*" MinWidth="170" SortMemberPath="DisplayUser">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <DockPanel ToolTip="{Binding FilePath}">
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0"
                                                            Background="{Binding DisplayUser, Converter={StaticResource AvatarBrush}}">
                                                        <TextBlock Text="{Binding DisplayUser, Converter={StaticResource Initials}}" FontSize="12" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{Binding DisplayUser, Converter={StaticResource AvatarBrush}, ConverterParameter=fg}"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayUser}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding FileName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ContainerType, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{l:Tr Main.Grid.Usage}" Width="1.5*" MinWidth="130" SortMemberPath="UsagePercent">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="50"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Style="{StaticResource BarTrack}">
                                                        <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="4" RenderTransformOrigin="0,0">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding UsagePercent, Converter={StaticResource Scale}}"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding UsageText}" HorizontalAlignment="Right" Style="{StaticResource Mono}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Severity, Converter={StaticResource SevBrush}, ConverterParameter=text}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{l:Tr Main.Grid.Size}" Width="92" SortMemberPath="FileSize">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" ToolTip="{l:Tr Main.Grid.SizeTip}">
                                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource Mono}"/>
                                                    <TextBlock Text="{l:Tr Main.Grid.OfMax, Arg={Binding MaxSizeText}}" Style="{StaticResource MutedText}" FontSize="11"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{l:Tr Main.Grid.Compaction}" Width="100" SortMemberPath="Reclaimable">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock x:Name="t" Text="{Binding ReclaimableText}" Style="{StaticResource Mono}"
                                                           Foreground="{DynamicResource Muted}" VerticalAlignment="Center"
                                                           ToolTip="{l:Tr Main.Grid.CompactionTip}"/>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding WorthCompacting}" Value="True">
                                                        <Setter TargetName="t" Property="Foreground" Value="{DynamicResource Accent}"/>
                                                        <Setter TargetName="t" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="{l:Tr Main.Grid.Growth}" Width="118" SortMemberPath="DailyGrowth">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding GrowthSpanText}">
                                                    <TextBlock Text="{Binding GrowthText}" Style="{StaticResource Mono}"/>
                                                    <TextBlock x:Name="eta" Text="{Binding EtaText}" Style="{StaticResource MutedText}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis" Visibility="{Binding EtaText, Converter={StaticResource Vis}}"/>
                                                </StackPanel>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding EtaSoon}" Value="True">
                                                        <Setter TargetName="eta" Property="Foreground" Value="{DynamicResource CritText}"/>
                                                        <Setter TargetName="eta" Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- state chip + host; while an operation runs, its stage and progress replace them -->
                                    <DataGridTemplateColumn Header="{l:Tr Main.Grid.State}" Width="1.3*" MinWidth="120" SortMemberPath="State">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid VerticalAlignment="Center">
                                                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource Vis}, ConverterParameter=!}">
                                                        <Border Style="{StaticResource Chip}" Background="{Binding State, Converter={StaticResource SevBrush}, ConverterParameter=soft}">
                                                            <TextBlock Text="{Binding StateLabel}" Style="{StaticResource ChipText}"
                                                                       Foreground="{Binding State, Converter={StaticResource SevBrush}, ConverterParameter=text}"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding StateHost}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Margin="2,2,0,0" ToolTip="{Binding MountedBy}" Visibility="{Binding StateHost, Converter={StaticResource Vis}}"/>
                                                    </StackPanel>
                                                    <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding BusyPercentText}" DockPanel.Dock="Right" FontSize="11" FontWeight="SemiBold"
                                                                       FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}" Margin="6,0,0,0"/>
                                                            <TextBlock Text="{Binding Busy}" Foreground="{DynamicResource Accent}" FontSize="11.5" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <Border Style="{StaticResource BarTrack}" Height="5" Margin="0,4,0,0" Background="{DynamicResource AccentSoft}">
                                                            <Border Background="{DynamicResource Accent}" CornerRadius="3" RenderTransformOrigin="0,0">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding BusyPercent, Converter={StaticResource Scale}}"/>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- last change + flags (orphan, disabled, stale, RW-diff, FS check) -->
                                    <DataGridTemplateColumn Header="{l:Tr Main.Grid.Modified}" Width="128" SortMemberPath="LastWrite">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding LastWrite, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="12"/>
                                                    <Border Style="{StaticResource Chip}" Background="{DynamicResource WarnSoft}" Margin="0,2,0,0" Padding="7,0,7,1"
                                                            ToolTip="{Binding FlagsText}" Visibility="{Binding FlagsText, Converter={StaticResource Vis}}">
                                                        <TextBlock Text="{Binding FlagsText}" Style="{StaticResource ChipText}" FontSize="11" Foreground="{DynamicResource WarnText}"/>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Width="48" CanUserSort="False" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource IconButton}" ToolTip="{l:Tr Main.Grid.RefreshOneTip}"
                                                        AutomationProperties.Name="{l:Tr Main.Grid.RefreshOneTip}"
                                                        Command="{Binding DataContext.RefreshOneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <ContentControl Style="{StaticResource Ic}" Width="15" Height="15" Tag="{StaticResource I.Refresh}"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding TotalCount, Converter={StaticResource Vis}, ConverterParameter=!}">
                                <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoft}" HorizontalAlignment="Center">
                                    <ContentControl Style="{StaticResource Ic}" Width="24" Height="24" Tag="{StaticResource I.Drive}"
                                                    Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{l:Tr Main.Empty.Title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                                <TextBlock Text="{l:Tr Main.Empty.Hint}" Style="{StaticResource MutedText}" FontSize="13" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ───────── details column ───────── -->
                <Grid Grid.Column="2">
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=!}">
                        <TextBlock Text="{l:Tr Main.Details.SelectHint}" Style="{StaticResource MutedText}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0"
                                  Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                        <StackPanel DataContext="{Binding Selected}">

                            <!-- who + gauge -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="26" Margin="0,0,12,0" VerticalAlignment="Top"
                                                Background="{Binding DisplayUser, Converter={StaticResource AvatarBrush}}">
                                            <TextBlock Text="{Binding DisplayUser, Converter={StaticResource Initials}}" FontSize="17" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding DisplayUser, Converter={StaticResource AvatarBrush}, ConverterParameter=fg}"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayUser}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Sid}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}"
                                                       TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding Sid, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding FilePath}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource Muted}"
                                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,4"
                                                Background="{Binding State, Converter={StaticResource SevBrush}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding StateText}" Style="{StaticResource ChipText}" TextWrapping="Wrap" MaxWidth="300"
                                                       Foreground="{Binding State, Converter={StaticResource SevBrush}, ConverterParameter=text}"/>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="{DynamicResource WarnSoft}" Margin="0,0,6,4"
                                                Visibility="{Binding FlagsText, Converter={StaticResource Vis}}">
                                            <TextBlock Text="{Binding FlagsText}" Style="{StaticResource ChipText}" TextWrapping="Wrap" MaxWidth="300"
                                                       Foreground="{DynamicResource WarnText}"/>
                                        </Border>
                                    </WrapPanel>

                                    <!-- ring gauge + key numbers -->
                                    <DockPanel Margin="0,10,0,0">
                                        <Grid DockPanel.Dock="Left" Width="112" Height="112" Margin="0,0,16,0" VerticalAlignment="Top">
                                            <Viewbox>
                                                <Canvas Width="120" Height="120">
                                                    <Ellipse Canvas.Left="10" Canvas.Top="10" Width="100" Height="100" Stroke="{DynamicResource Track}" StrokeThickness="11"/>
                                                    <Path Data="{Binding UsagePercent, Converter={StaticResource Arc}}" StrokeThickness="11"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Stroke="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                                                </Canvas>
                                            </Viewbox>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UsageText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"
                                                           Foreground="{Binding Severity, Converter={StaticResource SevBrush}, ConverterParameter=text}"/>
                                                <TextBlock Text="{l:Tr Main.Details.UsageCaption}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                        <!-- next to the ring: the file size, large -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Main.Details.FileSize}" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding SizeText}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="{l:Tr Main.Grid.OfMax, Arg={Binding MaxSizeText}}" Style="{StaticResource MutedText}"
                                                       ToolTip="{l:Tr Main.Details.MaxSize}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- the other numbers under the ring, across the whole card -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:Tr Main.Details.Volume}" Style="{StaticResource KvLabel}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding VolumeText}" Style="{StaticResource KvValue}"/>
                                        <TextBlock Grid.Row="1" Text="{l:Tr Main.Details.Reclaimable}" Style="{StaticResource KvLabel}"
                                                   ToolTip="{l:Tr Main.Details.ReclaimableTip}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReclaimableDetail}" Style="{StaticResource KvValue}"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Grid.Row="2" Text="{l:Tr Main.Details.Fs}" Style="{StaticResource KvLabel}" ToolTip="{l:Tr Main.Details.FsTip}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FsText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource KvValue}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding FsDirty}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource CritText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <!-- size history -->
                                    <Border Style="{StaticResource SoftCard}" Margin="0,14,0,0" Visibility="{Binding Spark, Converter={StaticResource Vis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock HorizontalAlignment="Right" FontSize="12" ToolTip="{Binding GrowthSpanText}" DockPanel.Dock="Right">
                                                    <Run Text="{Binding GrowthText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{l:Tr Main.Details.GrowthSpan, Arg={Binding GrowthSpanDays, Mode=OneWay}}" Foreground="{DynamicResource Muted}"/>
                                                </TextBlock>
                                                <TextBlock Text="{l:Tr Main.Details.SizeHistory}" Style="{StaticResource MutedText}"/>
                                            </DockPanel>
                                            <Viewbox Stretch="Uniform" Margin="0,8,0,6">
                                                <Grid Width="300" Height="48">
                                                    <Polyline Points="{Binding Spark}" Stroke="{DynamicResource Accent}" StrokeThickness="2"
                                                              StrokeLineJoin="Round"/>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="{Binding SparkCaption}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding EtaText}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding EtaText, Converter={StaticResource Vis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarnText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding EtaSoon}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource CritText}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- the rest of the facts, on demand -->
                                    <Expander Style="{StaticResource Disclosure}" Header="{l:Tr Main.Details.More}" Margin="0,8,0,0">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{l:Tr Main.Details.Modified}" Style="{StaticResource KvLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding LastWrite, StringFormat='dd.MM.yyyy HH:mm'}" Style="{StaticResource KvValue}"/>
                                            <TextBlock Grid.Row="1" Text="{l:Tr Main.Details.Session}" Style="{StaticResource KvLabel}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MountedBy}" Style="{StaticResource KvValue}"/>
                                            <TextBlock Grid.Row="2" Text="{l:Tr Main.Details.Refreshed}" Style="{StaticResource KvLabel}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RefreshedText}" Style="{StaticResource KvValue}"
                                                       ToolTip="{l:Tr Main.Details.RefreshedTip}"/>
                                            <TextBlock Grid.Row="3" Text="{l:Tr Main.Details.Analyzed}" Style="{StaticResource KvLabel}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AnalyzedText}" Style="{StaticResource KvValue}"
                                                       ToolTip="{l:Tr Main.Details.AnalyzedTip}"/>
                                            <TextBlock Grid.Row="4" Text="{l:Tr Main.Details.Account}" Style="{StaticResource KvLabel}"
                                                       ToolTip="{l:Tr Main.Details.AccountTip}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding AdText}" Style="{StaticResource KvValue}"/>
                                        </Grid>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <!-- operation progress -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                                    Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding BusyPercentText}" DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}" VerticalAlignment="Center"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding BusyOp}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Busy}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Style="{StaticResource BarTrack}" Background="{DynamicResource AccentSoft}" Margin="0,10,0,8">
                                        <Border Background="{DynamicResource Accent}" CornerRadius="4" RenderTransformOrigin="0,0">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding BusyPercent, Converter={StaticResource Scale}}"/>
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                    <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11.5"
                                               Visibility="{Binding BusyDetail, Converter={StaticResource Vis}}"/>
                                    <DockPanel Margin="0,8,0,0">
                                        <Button Content="{l:Tr Common.Cancel}" DockPanel.Dock="Right" Padding="14,0" MinHeight="32"
                                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                        <TextBlock Text="{l:Tr Main.Busy.Elapsed, Arg={Binding BusyElapsed}}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <!-- actions (hero card); bound to the window: they apply to the checked containers or the selected one -->
                            <Border Style="{StaticResource HeroCard}" Margin="0,12,0,0"
                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel>
                                    <DockPanel Margin="8,4,8,8">
                                        <TextBlock Text="{Binding ActionsTarget}" DockPanel.Dock="Right" FontSize="12" Opacity="0.78" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{l:Tr Main.Actions.Title}" FontSize="16" FontWeight="SemiBold"/>
                                    </DockPanel>

                                    <Button Style="{StaticResource HeroAction}" Command="{Binding MeasureCommand}" ToolTip="{l:Tr Main.Actions.MeasureTip}">
                                        <DockPanel>
                                            <Border Style="{StaticResource HeroIconCircle}"><ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Gauge}" HorizontalAlignment="Center"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{l:Tr Main.Actions.Measure}" Style="{StaticResource ActionTitle}"/>
                                                <TextBlock Text="{l:Tr Main.Actions.MeasureDesc}" Style="{StaticResource ActionDesc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource HeroAction}" Command="{Binding AnalyzeCommand}" ToolTip="{l:Tr Main.Actions.AnalyzeTip}">
                                        <DockPanel>
                                            <Border Style="{StaticResource HeroIconCircle}"><ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Bars}" HorizontalAlignment="Center"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{l:Tr Main.Actions.Analyze}" Style="{StaticResource ActionTitle}"/>
                                                <TextBlock Text="{l:Tr Main.Actions.AnalyzeDesc}" Style="{StaticResource ActionDesc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource HeroPrimaryAction}" Command="{Binding CleanCommand}" ToolTip="{l:Tr Main.Actions.CleanTip}" Margin="0,2">
                                        <DockPanel>
                                            <Border Style="{StaticResource HeroIconCircle}" Background="{DynamicResource HeroPrimaryItem}">
                                                <ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Sparkle}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Selected.EstimateTotalText, StringFormat='≈ {0}'}" FontSize="12" FontWeight="Bold"
                                                       VerticalAlignment="Center" Margin="8,0,4,0"
                                                       Visibility="{Binding Selected.Estimates, Converter={StaticResource Vis}}"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{l:Tr Main.Actions.Clean}" Style="{StaticResource ActionTitle}" FontWeight="Bold"/>
                                                <TextBlock Text="{l:Tr Main.Actions.CleanDesc}" Style="{StaticResource ActionDesc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource HeroAction}" Command="{Binding CompactCommand}" ToolTip="{l:Tr Main.Actions.CompactTip}">
                                        <DockPanel>
                                            <Border Style="{StaticResource HeroIconCircle}"><ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Compress}" HorizontalAlignment="Center"/></Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{l:Tr Main.Actions.Compact}" Style="{StaticResource ActionTitle}"/>
                                                <TextBlock Text="{l:Tr Main.Actions.CompactDesc}" Style="{StaticResource ActionDesc}"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>

                                    <!-- delete: shown when a stale / disabled container is targeted, enabled only if ALL targets may be deleted -->
                                    <StackPanel Visibility="{Binding ShowDelete, Converter={StaticResource Vis}}" Margin="4,8,4,0">
                                        <Button Style="{StaticResource HeroDangerButton}" Command="{Binding DeleteCommand}"
                                                ToolTip="{Binding DeleteHint}" ToolTipService.ShowOnDisabled="True">
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Trash}"/>
                                                <TextBlock Text="{Binding DeleteLabel}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Text="{Binding DeleteHint}" TextWrapping="Wrap" FontSize="11.5" Margin="4,6,4,0" Opacity="0.85"
                                                   Visibility="{Binding DeleteBlocked, Converter={StaticResource Vis}}"/>
                                    </StackPanel>

                                    <Expander Style="{StaticResource Disclosure}" BorderBrush="{DynamicResource OnHero}" Background="{DynamicResource HeroHover}" Header="{l:Tr Main.Actions.More}" Margin="0,8,0,0">
                                        <StackPanel Margin="0,4,0,0">
                                            <Button Style="{StaticResource HeroAction}" Command="{Binding GrowCommand}" ToolTip="{l:Tr Main.Actions.GrowTip}">
                                                <DockPanel>
                                                    <Border Style="{StaticResource HeroIconCircle}"><ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Expand}" HorizontalAlignment="Center"/></Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{l:Tr Main.Actions.Grow}" Style="{StaticResource ActionTitle}"/>
                                                        <TextBlock Text="{l:Tr Main.Actions.GrowDesc}" Style="{StaticResource ActionDesc}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <Button Style="{StaticResource HeroAction}" Command="{Binding RepairFsCommand}" ToolTip="{l:Tr Main.Actions.RepairFsTip}">
                                                <DockPanel>
                                                    <Border Style="{StaticResource HeroIconCircle}"><ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Shield}" HorizontalAlignment="Center"/></Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{l:Tr Main.Actions.RepairFs}" Style="{StaticResource ActionTitle}"/>
                                                        <TextBlock Text="{l:Tr Main.Actions.RepairFsDesc}" Style="{StaticResource ActionDesc}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Button>
                                            <Button Style="{StaticResource HeroAction}" Command="{Binding OpenFolderCommand}">
                                                <DockPanel>
                                                    <Border Style="{StaticResource HeroIconCircle}"><ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Folder}" HorizontalAlignment="Center"/></Border>
                                                    <TextBlock Text="{l:Tr Main.ShowInExplorer}" Style="{StaticResource ActionTitle}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                            </Button>

                                            <!-- RDS session of the user (container open over SMB by a session host) -->
                                            <StackPanel Visibility="{Binding Selected.HasSessionHost, Converter={StaticResource Vis}}" Margin="4,8,4,0">
                                                <TextBlock Text="{l:Tr Main.Session.Title}" FontSize="11" FontWeight="SemiBold" Opacity="0.78" Margin="4,0,0,6"/>
                                                <UniformGrid Columns="2">
                                                    <Button Content="{l:Tr Main.Session.Message}" Style="{StaticResource HeroOutlineButton}" Margin="0,0,3,0"
                                                            Command="{Binding MessageCommand}" ToolTip="{l:Tr Main.Session.MessageTip}"/>
                                                    <Button Content="{l:Tr Main.Session.Logoff}" Style="{StaticResource HeroDangerButton}" Margin="3,0,0,0"
                                                            Command="{Binding LogoffCommand}" ToolTip="{l:Tr Main.Session.LogoffTip}"/>
                                                </UniformGrid>
                                            </StackPanel>
                                            <Button Style="{StaticResource HeroDangerButton}" Margin="4,8,4,4" Command="{Binding UnmountCommand}"
                                                    ToolTip="{l:Tr Main.Actions.UnmountTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Eject}"/>
                                                    <TextBlock Text="{l:Tr Main.Actions.Unmount}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SoftCard}" Margin="0,12,0,0" Visibility="{Binding LastResult, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="12"/>
                            </Border>

                            <!-- estimates -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding Estimates, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding EstimateTotalText}" DockPanel.Dock="Right" Foreground="{DynamicResource OkText}" FontWeight="Bold"/>
                                        <TextBlock Text="{l:Tr Main.Estimates.Title}" Style="{StaticResource CardTitle}" FontSize="14"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding Estimates}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,3">
                                                    <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Style="{StaticResource Mono}"/>
                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- top folders -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding TopFolders, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding AnalyzedText}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Bottom"/>
                                        <TextBlock Text="{l:Tr Main.TopFolders.Title}" Style="{StaticResource CardTitle}" FontSize="14"/>
                                    </DockPanel>

                                    <!-- breadcrumbs: ← Огляд › AppData › Local › Microsoft -->
                                    <DockPanel Margin="0,0,0,6" Visibility="{Binding IsDrilled, Converter={StaticResource Vis}}">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="26" Height="26" Margin="0,0,4,0"
                                                ToolTip="{l:Tr Main.TopFolders.Up}" AutomationProperties.Name="{l:Tr Main.TopFolders.Up}"
                                                Command="{Binding DataContext.DrillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="up">
                                            <ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.ArrowLeft}"/>
                                        </Button>
                                        <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="{Binding Name}" Style="{StaticResource LinkButton}" Padding="3,1" FontSize="12"
                                                                Command="{Binding DataContext.DrillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"/>
                                                        <TextBlock Text="›" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="1,0"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding TopFolders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button x:Name="row" Command="{Binding DataContext.DrillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Cursor="Arrow" Margin="-8,0" Padding="8,5"
                                                        HorizontalContentAlignment="Stretch" Foreground="{DynamicResource Text}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource Hover}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <ContentControl x:Name="chev" DockPanel.Dock="Right" Style="{StaticResource Ic}" Width="13" Height="13"
                                                                            Tag="{StaticResource I.ChevronRight}" Foreground="{DynamicResource Accent}"
                                                                            Visibility="Hidden" Margin="6,0,0,0"/>
                                                            <Button x:Name="del" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24"
                                                                    Margin="6,-4,0,-4" Visibility="Collapsed" Cursor="Hand"
                                                                    ToolTip="{l:Tr Main.TopFolders.DeleteTip}" AutomationProperties.Name="{l:Tr Main.TopFolders.DeleteTip}"
                                                                    Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}">
                                                                <ContentControl Style="{StaticResource Ic}" Width="13" Height="13" Tag="{StaticResource I.Trash}"/>
                                                            </Button>
                                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Style="{StaticResource Mono}"/>
                                                            <TextBlock x:Name="name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                        </DockPanel>
                                                        <Border x:Name="bar" Style="{StaticResource BarTrack}" Height="5" Margin="0,4,0,0">
                                                            <Border Background="{DynamicResource Accent}" CornerRadius="3" RenderTransformOrigin="0,0">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding Fraction, Converter={StaticResource Scale}, ConverterParameter=1}"/>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding CanDrill}" Value="True">
                                                        <Setter TargetName="row" Property="Cursor" Value="Hand"/>
                                                        <Setter TargetName="row" Property="ToolTip" Value="{l:Tr Main.TopFolders.DrillTip}"/>
                                                        <Setter TargetName="chev" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                        <Setter TargetName="del" Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                                        <Setter TargetName="row" Property="IsHitTestVisible" Value="False"/>
                                                        <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Muted}"/>
                                                        <Setter TargetName="bar" Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- top files -->
                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding TopFiles, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{l:Tr Main.TopFiles.Title}" Style="{StaticResource CardTitle}" FontSize="14" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding TopFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,5" ToolTip="{Binding Path}">
                                                    <DockPanel>
                                                        <!-- delete this file from the container (disabled for globalExclude) -->
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="24" Height="24" Margin="6,-4,-4,-4"
                                                                ToolTip="{l:Tr Main.TopFiles.DeleteTip}" AutomationProperties.Name="{l:Tr Main.TopFiles.DeleteTip}"
                                                                Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}">
                                                            <ContentControl Style="{StaticResource Ic}" Width="13" Height="13" Tag="{StaticResource I.Trash}"/>
                                                        </Button>
                                                        <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" Style="{StaticResource Mono}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding ModifiedText}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11" Margin="8,0,0,0"/>
                                                        <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                    </DockPanel>
                                                    <Border Style="{StaticResource BarTrack}" Height="5" Margin="0,4,0,0">
                                                        <Border Background="{DynamicResource Accent}" CornerRadius="3" RenderTransformOrigin="0,0">
                                                            <Border.RenderTransform>
                                                                <ScaleTransform ScaleX="{Binding Fraction, Converter={StaticResource Scale}, ConverterParameter=1}"/>
                                                            </Border.RenderTransform>
                                                        </Border>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- ═════════════════════════ PAGE: SETTINGS ═════════════════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding IsSettingsPage, Converter={StaticResource Vis}}">
            <StackPanel MaxWidth="1240" HorizontalAlignment="Stretch">
                <TextBlock Text="{l:Tr Settings.Title}" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="{l:Tr Settings.Subtitle}" Style="{StaticResource MutedText}" FontSize="13" Margin="0,2,0,18"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <!-- profile paths -->
                        <Border Style="{StaticResource Card}" Padding="20">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Settings.Paths.Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,12"/>
                                <ItemsControl ItemsSource="{Binding Paths}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SoftCard}" CornerRadius="18" Padding="14,12" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Margin="0,0,14,0" VerticalAlignment="Center"
                                                            Background="{Binding Severity, Converter={StaticResource SevBrush}, ConverterParameter=soft}">
                                                        <ContentControl Style="{StaticResource Ic}" Width="18" Height="18" Tag="{StaticResource I.Drive}" HorizontalAlignment="Center"
                                                                        Foreground="{Binding Severity, Converter={StaticResource SevBrush}, ConverterParameter=text}"/>
                                                    </Border>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="10,0,0,0"
                                                            ToolTip="{l:Tr Main.Sidebar.RemovePath}" AutomationProperties.Name="{l:Tr Main.Sidebar.RemovePath}"
                                                            Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.X}"/>
                                                    </Button>
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ContainersText}" Style="{StaticResource MutedText}" Margin="12,0,0,0"/>
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource Mono}" FontSize="13" FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                        </DockPanel>
                                                        <Border Style="{StaticResource BarTrack}" Margin="0,8,0,6" Visibility="{Binding HasSpace, Converter={StaticResource Vis}}">
                                                            <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="4" RenderTransformOrigin="0,0">
                                                                <Border.RenderTransform>
                                                                    <ScaleTransform ScaleX="{Binding UsedPercent, Converter={StaticResource Scale}}"/>
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Border>
                                                        <TextBlock x:Name="space" Text="{Binding SpaceText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                    <Setter TargetName="space" Property="Foreground" Value="{DynamicResource CritText}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                    <Setter TargetName="space" Property="Foreground" Value="{DynamicResource WarnText}"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{l:Tr Main.Sidebar.NoPaths}" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                                           Visibility="{Binding Paths.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                                <DockPanel Margin="0,4,0,0">
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Main.Sidebar.BrowseFolder}" Height="40" Margin="8,0,0,0"
                                            Command="{Binding AddPathCommand}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Height="40" Margin="8,0,0,0" Padding="16,0"
                                            Click="AddTypedPath_Click" ToolTip="{l:Tr Main.Sidebar.AddTypedPath}">
                                        <StackPanel Orientation="Horizontal">
                                            <ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Plus}"/>
                                            <TextBlock Text="{l:Tr Settings.Paths.Add}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <TextBox x:Name="PathBox" MinHeight="40" v:Ui.CornerRadius="20" Padding="16,0"
                                             v:Ui.Placeholder="{l:Tr Main.Sidebar.PathBoxTip}" AutomationProperties.Name="{l:Tr Main.Sidebar.PathBoxTip}"
                                             KeyDown="PathBox_KeyDown"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- thresholds -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="{l:Tr Settings.Thresholds.Reset}" Style="{StaticResource LinkButton}"
                                            Command="{Binding ResetThresholdsCommand}" ToolTip="{l:Tr Settings.Thresholds.ResetTip}"/>
                                    <TextBlock Text="{l:Tr Settings.Thresholds.Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <!-- warning -->
                                <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{DynamicResource Warn}" Margin="0,0,14,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="%" Width="44" Style="{StaticResource MutedText}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" CornerRadius="19" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource StepButton}" Command="{Binding StepThresholdCommand}" CommandParameter="warn:-1"
                                                        AutomationProperties.Name="{l:Tr Settings.Step.Minus}"><ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Minus}"/></Button>
                                                <TextBox Style="{StaticResource StepBox}" Text="{Binding DraftWarn, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="{l:Tr Settings.Thresholds.Warn}"/>
                                                <Button Style="{StaticResource StepButton}" Command="{Binding StepThresholdCommand}" CommandParameter="warn:1"
                                                        AutomationProperties.Name="{l:Tr Settings.Step.Plus}"><ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Plus}"/></Button>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Settings.Thresholds.Warn}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{l:Tr Settings.Thresholds.WarnDesc}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- critical -->
                                <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{DynamicResource Crit}" Margin="0,0,14,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="%" Width="44" Style="{StaticResource MutedText}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" CornerRadius="19" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource StepButton}" Command="{Binding StepThresholdCommand}" CommandParameter="crit:-1"
                                                        AutomationProperties.Name="{l:Tr Settings.Step.Minus}"><ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Minus}"/></Button>
                                                <TextBox Style="{StaticResource StepBox}" Text="{Binding DraftCrit, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="{l:Tr Settings.Thresholds.Crit}"/>
                                                <Button Style="{StaticResource StepButton}" Command="{Binding StepThresholdCommand}" CommandParameter="crit:1"
                                                        AutomationProperties.Name="{l:Tr Settings.Step.Plus}"><ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Plus}"/></Button>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Settings.Thresholds.Crit}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{l:Tr Settings.Thresholds.CritDesc}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- stale -->
                                <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{DynamicResource Neutral}" Margin="0,0,14,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{l:Tr Settings.Unit.Days}" Width="44" Style="{StaticResource MutedText}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" CornerRadius="19" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource StepButton}" Command="{Binding StepThresholdCommand}" CommandParameter="stale:-1"
                                                        AutomationProperties.Name="{l:Tr Settings.Step.Minus}"><ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Minus}"/></Button>
                                                <TextBox Style="{StaticResource StepBox}" Text="{Binding DraftStale, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="{l:Tr Settings.Thresholds.Stale}"/>
                                                <Button Style="{StaticResource StepButton}" Command="{Binding StepThresholdCommand}" CommandParameter="stale:1"
                                                        AutomationProperties.Name="{l:Tr Settings.Step.Plus}"><ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Plus}"/></Button>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Settings.Thresholds.Stale}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{l:Tr Settings.Thresholds.StaleDesc}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- worth compacting -->
                                <Border BorderBrush="{DynamicResource LineSoft}" BorderThickness="0,0,0,1" Padding="0,10" ToolTip="{l:Tr Main.Sidebar.CompactMinTip}">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{DynamicResource Accent}" Margin="0,0,14,0"/>
                                        <TextBlock DockPanel.Dock="Right" Text="GB" Width="44" Style="{StaticResource MutedText}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        <Border DockPanel.Dock="Right" CornerRadius="19" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource StepButton}" Command="{Binding StepThresholdCommand}" CommandParameter="compact:-1"
                                                        AutomationProperties.Name="{l:Tr Settings.Step.Minus}"><ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Minus}"/></Button>
                                                <TextBox Style="{StaticResource StepBox}" Text="{Binding DraftCompactMin, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="{l:Tr Settings.Thresholds.CompactMin}"/>
                                                <Button Style="{StaticResource StepButton}" Command="{Binding StepThresholdCommand}" CommandParameter="compact:1"
                                                        AutomationProperties.Name="{l:Tr Settings.Step.Plus}"><ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.Plus}"/></Button>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Settings.Thresholds.CompactMin}" FontSize="13.5" FontWeight="SemiBold"/>
                                            <TextBlock Text="{l:Tr Settings.Thresholds.CompactMinDesc}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <!-- compact after cleanup (applies right away, saved with the button below) -->
                                <DockPanel Margin="0,12,0,0">
                                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding Settings.CompactAfterCleanup}"
                                              AutomationProperties.Name="{l:Tr Main.Sidebar.CompactAfterCleanup}" VerticalAlignment="Center"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{l:Tr Main.Sidebar.CompactAfterCleanup}" FontSize="13.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="{l:Tr Settings.Thresholds.CompactAfterDesc}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="{l:Tr Main.Sidebar.ApplySave}" Style="{StaticResource PrimaryButton}" Height="42" Padding="22,0"
                                            Command="{Binding SaveSettingsCommand}"/>
                                    <TextBlock Text="{l:Tr Settings.Thresholds.Dirty}" Foreground="{DynamicResource WarnText}" FontWeight="SemiBold" FontSize="12.5"
                                               VerticalAlignment="Center" Margin="14,0,0,0"
                                               Visibility="{Binding ThresholdsDirty, Converter={StaticResource Vis}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <!-- cleanup rules (hero card) -->
                        <Border Style="{StaticResource HeroCard}" Padding="20">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="cleanup-rules.json" DockPanel.Dock="Right" FontSize="12" Opacity="0.78" VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="{l:Tr Settings.Rules.Title}" FontSize="16" FontWeight="SemiBold"/>
                                </DockPanel>
                                <UniformGrid Columns="2" Margin="0,14,0,0">
                                    <Border Background="{DynamicResource HeroHover}" CornerRadius="16" Padding="14,10" Margin="0,0,5,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding RulesOn}" FontSize="26" FontWeight="SemiBold"/>
                                            <TextBlock Text="{l:Tr Settings.Rules.ActiveOf, Arg={Binding RulesTotal}}" FontSize="12" Opacity="0.78" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource HeroHover}" CornerRadius="16" Padding="14,10" Margin="5,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding GlobalExcludeCount}" FontSize="26" FontWeight="SemiBold"/>
                                            <TextBlock Text="{l:Tr Settings.Rules.Excludes}" FontSize="12" Opacity="0.78" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                                <!-- rules file cannot be read: the error instead of the numbers -->
                                <Border Background="{DynamicResource HeroDanger}" CornerRadius="12" Padding="12,8" Margin="0,10,0,0"
                                        Visibility="{Binding RulesError, Converter={StaticResource Vis}}">
                                    <TextBlock Text="{Binding RulesSummary}" Foreground="{DynamicResource HeroDangerText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                                <ItemsControl ItemsSource="{Binding RuleChips}" Margin="0,8,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource HeroItem}" CornerRadius="13" Padding="10,4" Margin="0,0,6,6">
                                                <TextBlock Text="{Binding}" FontSize="12"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RulesMore}" FontSize="12" Opacity="0.78" Margin="2,0,0,0"
                                           Visibility="{Binding RulesMore, Converter={StaticResource Vis}}"/>
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <Button Content="{l:Tr Main.Sidebar.EditRules}" Style="{StaticResource HeroPrimaryAction}" Margin="0,0,4,0"
                                            HorizontalContentAlignment="Center" FontWeight="SemiBold" Padding="10" v:Ui.CornerRadius="20"
                                            Command="{Binding EditRulesCommand}"/>
                                    <Button Content="{l:Tr Main.Sidebar.ReloadRules}" Style="{StaticResource HeroOutlineButton}" Margin="4,0,0,0"
                                            Command="{Binding ReloadRulesCommand}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- appearance: language + theme -->
                        <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{l:Tr Settings.Appearance.Title}" Style="{StaticResource CardTitle}"/>
                                <TextBlock Text="{l:Tr Settings.Appearance.Theme}" Style="{StaticResource MutedText}" Margin="0,14,0,6"/>
                                <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}"
                                         DisplayMemberPath="Name" AutomationProperties.Name="{l:Tr Settings.Appearance.Theme}"/>
                                <TextBlock Text="{l:Tr Lang.Label}" Style="{StaticResource MutedText}" Margin="0,14,0,6"/>
                                <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                                         DisplayMemberPath="Name" ToolTip="{l:Tr Lang.Tooltip}" AutomationProperties.Name="{l:Tr Lang.Label}"/>
                                <TextBlock Text="{l:Tr Settings.Appearance.Note}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- service -->
                        <Border Style="{StaticResource Card}" Padding="8" Margin="0,16,0,0">
                            <StackPanel>
                                <Button Style="{StaticResource HeroAction}" Foreground="{DynamicResource Text}" Command="{Binding OpenLogsCommand}" Padding="12">
                                    <DockPanel>
                                        <Border Style="{StaticResource HeroIconCircle}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource NeutralSoft}">
                                            <ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Folder}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource Ic}" Tag="{StaticResource I.ChevronRight}" Foreground="{DynamicResource Muted}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Main.Sidebar.OpenLogs}" Style="{StaticResource ActionTitle}" FontSize="13.5"/>
                                            <TextBlock Text="{l:Tr Settings.Service.LogsDesc}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                                <Button Style="{StaticResource HeroAction}" Foreground="{DynamicResource Text}" Click="Help_Click" Padding="12"
                                        ToolTip="{l:Tr Main.Sidebar.HelpButtonTip}">
                                    <DockPanel>
                                        <Border Style="{StaticResource HeroIconCircle}" Width="36" Height="36" CornerRadius="18" Background="{DynamicResource NeutralSoft}">
                                            <ContentControl Style="{StaticResource Ic}" Tag="{StaticResource I.Help}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource Ic}" Tag="{StaticResource I.ChevronRight}" Foreground="{DynamicResource Muted}"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{l:Tr Settings.Service.Help}" Style="{StaticResource ActionTitle}" FontSize="13.5"/>
                                            <TextBlock Text="{l:Tr Settings.Service.HelpDesc}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="8,14,8,0" LineHeight="18"
                                   Text="{l:Tr Main.Sidebar.EstimateNote}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════════════════════ LOG ═════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0"
                Visibility="{Binding IsLogOpen, Converter={StaticResource Vis}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding ToggleLogCommand}"
                            ToolTip="{l:Tr Main.Log.Close}" AutomationProperties.Name="{l:Tr Main.Log.Close}">
                        <ContentControl Style="{StaticResource Ic}" Width="14" Height="14" Tag="{StaticResource I.X}"/>
                    </Button>
                    <TextBlock Text="{l:Tr Main.Log.Title}" Style="{StaticResource CardTitle}" FontSize="14" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox ItemsSource="{Binding LogLines}" Height="150" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1">
                                <Run Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}" Foreground="{DynamicResource Muted}"/>
                                <Run Text="{Binding Level, Mode=OneWay}" x:Name="lvl" Foreground="{DynamicResource Accent}"/>
                                <Run Text="{Binding Text, Mode=OneWay}"/>
                            </TextBlock>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="WARN">
                                    <Setter TargetName="lvl" Property="Foreground" Value="{DynamicResource WarnText}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                    <Setter TargetName="lvl" Property="Foreground" Value="{DynamicResource CritText}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═════════════════════════ STATUS BAR ═════════════════════════ -->
        <Border Grid.Row="3" Margin="0,12,0,0" MinHeight="42" Padding="18,0,6,0" CornerRadius="21"
                Background="{DynamicResource Surface}" BorderBrush="{DynamicResource LineSoft}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{l:Tr Common.Cancel}" MinHeight="30" Padding="14,0" Margin="8,0,0,0" VerticalAlignment="Center"
                        Command="{Binding CancelCommand}" Visibility="{Binding IsIdle, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                <ProgressBar DockPanel.Dock="Right" Width="220" VerticalAlignment="Center" Margin="12,0,0,0" Value="{Binding Progress}"
                             IsIndeterminate="{Binding IsScanning}"
                             Visibility="{Binding IsIdle, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Ok}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsIdle}" Value="False">
                                    <Setter Property="Fill" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding Status}" FontSize="12.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
