<Window x:Class="FSLTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FSLTool.ViewModels"
        Title="FSLTool — FSLogix Profile Manager"
        Icon="pack://application:,,,/FSLTool;component/Assets/app.ico"
        Width="1480" Height="900" MinWidth="1100" MinHeight="650"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- stat card that lights up when its filter (Tag) is the active one -->
        <Style x:Key="FilterCard" TargetType="Border" BasedOn="{StaticResource Card}">
            <!-- 7 cards in a row: keep text room on 1366–1480 px screens -->
            <Setter Property="Padding" Value="11,10"/>
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource FilterMatch}">
                            <Binding Path="Filter"/>
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}"/>
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Background" Value="{StaticResource Selection}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- horizontal bar: track + scaled fill -->
        <Style x:Key="BarTrack" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Track}"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Height" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <!-- left panel: 290 px, or a 48 px strip when collapsed (Ctrl+B) -->
            <ColumnDefinition Width="{Binding IsSidebarCollapsed, Converter={StaticResource BoolLength}, ConverterParameter='48|290'}"/>
            <ColumnDefinition Width="*"/>
            <!-- details: narrowest width at which nothing overlaps or gets clipped (checked with worst-case content;
                 below ~300 the two-column action buttons stop fitting); long values wrap onto a second line -->
            <ColumnDefinition Width="310"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════════════════════ SIDEBAR ═════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
          <Grid>
            <!-- collapsed: a narrow strip with the logo and buttons to expand / open help -->
            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center"
                        Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Vis}}">
                <Image Width="30" Height="30" Source="pack://application:,,,/FSLTool;component/Assets/logo.png"
                       RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,14"/>
                <Button Content="»" Style="{StaticResource GhostButton}" FontSize="16" Padding="8,2"
                        Command="{Binding ToggleSidebarCommand}" ToolTip="Показати ліву панель (Ctrl+B)"/>
                <Button Content="?" Style="{StaticResource GhostButton}" FontSize="14" FontWeight="SemiBold" Padding="8,2" Margin="0,8,0,0"
                        Click="Help_Click" ToolTip="Довідка (F1)"/>
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource Vis}, ConverterParameter=!}">
                <StackPanel Margin="18">
                    <DockPanel Margin="0,0,0,22">
                        <Button DockPanel.Dock="Right" Content="«" Style="{StaticResource GhostButton}" FontSize="16" Padding="8,2"
                                VerticalAlignment="Top" Margin="0,-4,-10,0"
                                Command="{Binding ToggleSidebarCommand}" ToolTip="Згорнути ліву панель (Ctrl+B) — більше місця для таблиці"/>
                        <StackPanel Orientation="Horizontal">
                            <Image Width="40" Height="40" Source="pack://application:,,,/FSLTool;component/Assets/logo.png"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="FSLTool" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="FSLogix Profile Manager" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>

                    <TextBlock Text="ШЛЯХИ ДО ПРОФІЛІВ" Style="{StaticResource SectionTitle}"/>
                    <ItemsControl ItemsSource="{Binding Paths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface2}" CornerRadius="7" Padding="10,6,4,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"
                                                   VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <Button Grid.Column="1" Content="✕" Style="{StaticResource GhostButton}" ToolTip="Прибрати шлях"
                                                Command="{Binding DataContext.RemovePathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,6,0">
                                            <Border Style="{StaticResource BarTrack}" Height="4" Margin="0,0,0,4"
                                                    Visibility="{Binding HasSpace, Converter={StaticResource Vis}}">
                                                <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="2" RenderTransformOrigin="0,0">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding UsedPercent, Converter={StaticResource Scale}}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                            <TextBlock x:Name="space" Text="{Binding SpaceText}" Style="{StaticResource MutedText}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SpaceText}"/>
                                            <TextBlock Text="{Binding ContainersText}" Style="{StaticResource MutedText}" FontSize="11"
                                                       Visibility="{Binding ContainersText, Converter={StaticResource Vis}}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                        <Setter TargetName="space" Property="Foreground" Value="{StaticResource Crit}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                        <Setter TargetName="space" Property="Foreground" Value="{StaticResource Warn}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Шляхи ще не додано" Style="{StaticResource MutedText}" Margin="0,0,0,8"
                               Visibility="{Binding Paths.Count, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="PathBox" FontSize="12" ToolTip="D:\Profiles або \\server\share — Enter щоб додати"
                                 KeyDown="PathBox_KeyDown"/>
                        <Button Grid.Column="1" Content="+" Margin="6,0,0,0" Padding="12,5" ToolTip="Додати введений шлях"
                                Click="AddTypedPath_Click"/>
                    </Grid>
                    <Button Content="Обрати папку…" Margin="0,8,0,0" Command="{Binding AddPathCommand}"/>

                    <TextBlock Text="ПОРОГИ" Style="{StaticResource SectionTitle}" Margin="0,26,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" Margin="0,0,8,0"/>
                            <TextBlock Text="Попередження, %"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding Settings.WarnPercent, UpdateSourceTrigger=LostFocus}" Margin="0,3"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Crit}" Margin="0,0,8,0"/>
                            <TextBlock Text="Переповнений, %"/>
                        </StackPanel>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.CriticalPercent, UpdateSourceTrigger=LostFocus}" Margin="0,3"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Muted}" Margin="0,0,8,0"/>
                            <TextBlock Text="Неактивний, днів"/>
                        </StackPanel>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.StaleDays, UpdateSourceTrigger=LostFocus}" Margin="0,3"/>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip="Контейнер варто стиснути, якщо за даними аналізу файл VHDX більший за зайняте в томі щонайменше на стільки">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                            <TextBlock Text="Варто стиснути від, GB"/>
                        </StackPanel>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Settings.CompactMinGb, UpdateSourceTrigger=LostFocus}" Margin="0,3"/>
                    </Grid>
                    <CheckBox Content="Стискати після очищення" Margin="0,12,0,0" IsChecked="{Binding Settings.CompactAfterCleanup}"/>
                    <Button Content="Застосувати й зберегти" Margin="0,12,0,0" Command="{Binding SaveSettingsCommand}"/>

                    <TextBlock Text="ПРАВИЛА ОЧИЩЕННЯ" Style="{StaticResource SectionTitle}" Margin="0,26,0,8"/>
                    <TextBlock Text="{Binding RulesSummary}" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2">
                        <Button Content="Редагувати" Margin="0,0,3,0" Command="{Binding EditRulesCommand}"/>
                        <Button Content="Перечитати" Margin="3,0,0,0" Command="{Binding ReloadRulesCommand}"/>
                    </UniformGrid>
                    <Button Content="Відкрити журнали" Margin="0,8,0,0" Command="{Binding OpenLogsCommand}"/>
                    <Button Content="Довідка (F1)" Margin="0,8,0,0" Click="Help_Click"
                            ToolTip="Опис усіх функцій і режимів програми, включно з режимом без вікна"/>

                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,22,0,0" FontSize="11"
                               Text="* — заповнення оцінене за розміром файлу. Точне значення з'явиться після «Виміряти» або «Аналізувати» і зберігається між запусками, доки розмір файлу не зміниться."/>
                </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- ═════════════════════════ MAIN ═════════════════════════ -->
        <Grid Grid.Column="1" Margin="18,16,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- toolbar -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid MaxWidth="420" HorizontalAlignment="Left" Width="420">
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}" Padding="30,7,8,7"/>
                    <TextBlock Text="⌕" FontSize="16" Foreground="{StaticResource Muted}" Margin="10,0,0,2"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBlock Text="Пошук: користувач, шлях, хост…" Foreground="{StaticResource Muted}" Margin="31,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Visibility="{Binding Search, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Скасувати" Margin="0,0,8,0" Command="{Binding CancelCommand}"
                            Visibility="{Binding IsIdle, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                    <!-- split button: main action refreshes visible rows, ▾ opens the other variants -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Command="{Binding RefreshVisibleCommand}" Padding="12,7,10,7"
                                ToolTip="Перечитати розмір, макс. розмір, стан підключення та обліковий запис для контейнерів, видимих у таблиці">
                            <TextBlock>
                                <Run Text="⟳ Оновити видимі"/><Run Text="{Binding VisibleCount, Mode=OneWay, StringFormat=' ({0})'}" Foreground="{StaticResource Muted}"/>
                            </TextBlock>
                        </Button>
                        <Button x:Name="RefreshMenuButton" Content="▾" Padding="9,7" Margin="2,0,0,0" Click="RefreshMenu_Click"
                                ToolTip="Інші варіанти оновлення">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding RefreshVisibleCommand}">
                                        <MenuItem.Header>
                                            <TextBlock Text="{Binding VisibleCount, StringFormat='Оновити видимі ({0})'}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Command="{Binding RefreshCheckedCommand}">
                                        <MenuItem.Header>
                                            <TextBlock Text="{Binding CheckedCount, StringFormat='Оновити позначені ({0})'}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Command="{Binding RefreshAllCommand}">
                                        <MenuItem.Header>
                                            <TextBlock Text="{Binding TotalCount, StringFormat='Оновити всі ({0})'}"/>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <Button Content="⟳  Сканувати" Style="{StaticResource PrimaryButton}" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>

            <!-- stat cards -->
            <UniformGrid Grid.Row="1" Columns="7" Margin="0,16,0,0">
                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,8,0" HorizontalContentAlignment="Stretch"
                        Command="{Binding SetFilterCommand}" CommandParameter="All">
                    <Border Style="{StaticResource FilterCard}" Tag="All">
                        <StackPanel>
                            <TextBlock Text="Контейнерів" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding TotalSize}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,8,0" HorizontalContentAlignment="Stretch"
                        Command="{Binding SetFilterCommand}" CommandParameter="Problem">
                    <Border Style="{StaticResource FilterCard}" Tag="Problem">
                        <StackPanel>
                            <TextBlock Text="Переповнені" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="{Binding CriticalCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Crit}" Margin="0,4,0,0"/>
                            <TextBlock Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                                <Run Text="+"/><Run Text="{Binding WarningCount, Mode=OneWay}" Foreground="{StaticResource Warn}"/><Run Text=" близькі до межі"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,8,0" HorizontalContentAlignment="Stretch"
                        Command="{Binding SetFilterCommand}" CommandParameter="Mounted">
                    <Border Style="{StaticResource FilterCard}" Tag="Mounted">
                        <StackPanel>
                            <TextBlock Text="Підмонтовані" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="{Binding MountedCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Mount}" Margin="0,4,0,0"/>
                            <TextBlock Text="активні сесії" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,8,0" HorizontalContentAlignment="Stretch"
                        Command="{Binding SetFilterCommand}" CommandParameter="Orphan">
                    <Border Style="{StaticResource FilterCard}" Tag="Orphan">
                        <StackPanel>
                            <TextBlock Text="Сироти" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="{Binding OrphanCount}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding OrphanSize, StringFormat='{}{0} без власника'}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,8,0" HorizontalContentAlignment="Stretch"
                        Command="{Binding SetFilterCommand}" CommandParameter="Disabled"
                        ToolTip="Облікові записи є в AD, але вимкнені або з простроченим терміном дії">
                    <Border Style="{StaticResource FilterCard}" Tag="Disabled">
                        <StackPanel>
                            <TextBlock Text="Вимкнені в AD" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="{Binding DisabledCount}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding DisabledSize}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </StackPanel>
                    </Border>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="0" Margin="0,0,8,0" HorizontalContentAlignment="Stretch"
                        Command="{Binding SetFilterCommand}" CommandParameter="Stale">
                    <Border Style="{StaticResource FilterCard}" Tag="Stale">
                        <StackPanel>
                            <TextBlock Text="Неактивні" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="{Binding StaleCount}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding Settings.StaleDays, StringFormat='{}не змінювались > {0} дн.'}" Style="{StaticResource MutedText}"/>
                        </StackPanel>
                    </Border>
                </Button>
                <Button Style="{StaticResource GhostButton}" Padding="0" HorizontalContentAlignment="Stretch"
                        Command="{Binding SetFilterCommand}" CommandParameter="Compactable"
                        ToolTip="{Binding CompactableTip}">
                    <Border Style="{StaticResource FilterCard}" Tag="Compactable">
                        <StackPanel>
                            <TextBlock Text="Варто стиснути" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <TextBlock Text="{Binding CompactableCount}" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding CompactableHint}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Button>
            </UniformGrid>

            <!-- active filter (set by clicking a stat card) + check helpers -->
            <DockPanel Grid.Row="2" Margin="0,14,0,8" MinHeight="28">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsFiltered, Converter={StaticResource Vis}}">
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="Фільтр:"/>
                    <TextBlock Text="{Binding FilterLabel}" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding VisibleCount, StringFormat='{} · {0}'}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                    <Button Content="✕ Скинути" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                            Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                    <!-- "worth compacting" ⇄ "not measured yet": what to compact, and what to measure first -->
                    <Button Style="{StaticResource GhostButton}" Margin="12,0,0,0" Foreground="{StaticResource Accent}"
                            Command="{Binding SetFilterCommand}" CommandParameter="Unmeasured"
                            Visibility="{Binding ShowUnmeasuredLink, Converter={StaticResource Vis}}"
                            ToolTip="Вільні контейнери без точних даних — їх ще не враховано в «Варто стиснути». Позначте їх і натисніть «Виміряти»">
                        <TextBlock Text="{Binding UnmeasuredCount, StringFormat='{}Ще не виміряні: {0} →'}" Foreground="{StaticResource Accent}"/>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                            Command="{Binding SetFilterCommand}" CommandParameter="Compactable"
                            Visibility="{Binding ShowCompactableLink, Converter={StaticResource Vis}}">
                        <TextBlock Text="← Варто стиснути" Foreground="{StaticResource Accent}"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0"
                               Text="{Binding CheckedCount, StringFormat='{}Позначено: {0}'}"/>
                    <Button Content="Позначити видимі" Style="{StaticResource GhostButton}" Command="{Binding CheckAllCommand}" CommandParameter="1"/>
                    <Button Content="Зняти" Style="{StaticResource GhostButton}" Command="{Binding CheckAllCommand}" CommandParameter="0"/>
                </StackPanel>
            </DockPanel>

            <!-- profiles grid -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding Selected}" Margin="1" RowHeight="44"
                          Sorting="Grid_Sorting">
                    <DataGrid.Columns>
                        <!-- sortable by the check mark: first click puts checked rows on top (see Grid_Sorting) -->
                        <DataGridTemplateColumn Width="40" SortMemberPath="IsChecked">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="✓" ToolTip="Сортувати за позначкою: перший клік — позначені вгорі, наступний — унизу"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- each row has two lines: the main value above, details below (fewer columns, same information) -->
                        <DataGridTemplateColumn Header="КОРИСТУВАЧ" Width="2*" MinWidth="140" SortMemberPath="DisplayUser">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding FilePath}">
                                        <TextBlock Text="{Binding DisplayUser}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding FileName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ContainerType, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ЗАПОВНЕННЯ" Width="1.5*" MinWidth="120" SortMemberPath="UsagePercent">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource BarTrack}">
                                            <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="3" RenderTransformOrigin="0,0">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="{Binding UsagePercent, Converter={StaticResource Scale}}"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding UsageText}" HorizontalAlignment="Right"
                                                   FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                   Foreground="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="РОЗМІР" Width="88" SortMemberPath="FileSize">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="Розмір файлу VHDX / максимальний розмір із заголовка">
                                        <TextBlock Text="{Binding SizeText}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <TextBlock Text="{Binding MaxSizeText, StringFormat='з {0}'}" Style="{StaticResource MutedText}" FontSize="11"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="СТИСНЕННЯ" Width="96" SortMemberPath="Reclaimable">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock x:Name="t" Text="{Binding ReclaimableText}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                               ToolTip="Скільки місця приблизно поверне стиснення (розмір файлу − зайняте в томі, за даними аналізу)"/>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding WorthCompacting}" Value="True">
                                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource Accent}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ПРИРІСТ" Width="112" SortMemberPath="DailyGrowth">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding GrowthSpanText}">
                                        <TextBlock Text="{Binding GrowthText}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                        <TextBlock x:Name="eta" Text="{Binding EtaText}" Style="{StaticResource MutedText}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding EtaText, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding EtaSoon}" Value="True">
                                            <Setter TargetName="eta" Property="Foreground" Value="{StaticResource Crit}"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- state + host; while an operation runs, its stage and progress replace them -->
                        <DataGridTemplateColumn Header="СТАН" Width="1.2*" MinWidth="110" SortMemberPath="State">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <DockPanel Visibility="{Binding IsBusy, Converter={StaticResource Vis}, ConverterParameter=!}">
                                            <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource SevBrush}}" Margin="0,0,8,0"/>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StateLabel}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StateHost}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding MountedBy}" Visibility="{Binding StateHost, Converter={StaticResource Vis}}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource Vis}}" VerticalAlignment="Center">
                                            <DockPanel>
                                                <TextBlock Text="{Binding BusyPercentText}" DockPanel.Dock="Right" FontSize="11"
                                                           FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource Accent}" Margin="6,0,0,0"/>
                                                <TextBlock Text="{Binding Busy}" Foreground="{StaticResource Accent}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource BarTrack}" Height="4" Margin="0,3,0,0">
                                                <Border Background="{StaticResource Accent}" CornerRadius="2" RenderTransformOrigin="0,0">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding BusyPercent, Converter={StaticResource Scale}}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- last change + flags (orphan, disabled, stale, RW-diff, FS check) -->
                        <DataGridTemplateColumn Header="ЗМІНЕНО" Width="122" SortMemberPath="LastWrite">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LastWrite, StringFormat='dd.MM.yyyy HH:mm'}" FontSize="12"/>
                                        <TextBlock Text="{Binding FlagsText}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding FlagsText}" Visibility="{Binding FlagsText, Converter={StaticResource Vis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="44" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="⟳" Style="{StaticResource GhostButton}" FontSize="15" Padding="6,0"
                                            ToolTip="Оновити інформацію лише по цьому контейнеру"
                                            Command="{Binding DataContext.RefreshOneCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- empty state -->
            <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                        Visibility="{Binding TotalCount, Converter={StaticResource Vis}, ConverterParameter=!}">
                <TextBlock Text="Контейнерів не знайдено" FontSize="16" HorizontalAlignment="Center"/>
                <TextBlock Text="Додайте шлях до папки з профілями FSLogix зліва та натисніть «Сканувати»"
                           Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═════════════════════════ DETAILS ═════════════════════════ -->
        <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
            <Grid>
                <TextBlock Text="Оберіть контейнер у списку" Style="{StaticResource MutedText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding HasSelection, Converter={StaticResource Vis}, ConverterParameter=!}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasSelection, Converter={StaticResource Vis}}">
                    <StackPanel Margin="16" DataContext="{Binding Selected}">
                        <TextBlock Text="{Binding DisplayUser}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Sid}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding FilePath}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <!-- big gauge -->
                        <Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="{StaticResource Surface2}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Заповнення" Style="{StaticResource MutedText}"/>
                                    <TextBlock Text="{Binding UsageText}" HorizontalAlignment="Right" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{Binding Severity, Converter={StaticResource SevBrush}}"/>
                                </DockPanel>
                                <Border Background="{StaticResource Track}" CornerRadius="5" Height="10" Margin="0,8,0,10">
                                    <Border Background="{Binding Severity, Converter={StaticResource SevBrush}}" CornerRadius="5" RenderTransformOrigin="0,0">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding UsagePercent, Converter={StaticResource Scale}}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <!-- labels sit in an Auto column (never wrap); a value too long for its cell wraps
                                             onto a second right-aligned line instead of spilling over the label -->
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Margin" Value="0,2"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Style.Triggers>
                                                <!-- labels (column 0) stay left-aligned -->
                                                <Trigger Property="Grid.Column" Value="0">
                                                    <Setter Property="TextAlignment" Value="Left"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Resources>
                                    <TextBlock Text="Розмір файлу" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Text="Максимальний розмір" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MaxSizeText}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="2" Text="Зайнято в томі" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding VolumeText}"/>
                                    <TextBlock Grid.Row="3" Text="Поверне стиснення" Foreground="{StaticResource Muted}"
                                               ToolTip="Розмір файлу − зайняте в томі (верхня оцінка; відома після аналізу)"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding ReclaimableDetail}"/>
                                    <TextBlock Grid.Row="4" Text="Файлова система" Foreground="{StaticResource Muted}"
                                               ToolTip="Позначка NTFS «потрібна перевірка» (dirty bit), читається під час аналізу"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding FsText}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Margin" Value="0,2"/>
                                                <Setter Property="FontSize" Value="12"/>
                                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="TextAlignment" Value="Right"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FsDirty}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Crit}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Row="5" Text="Змінено" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LastWrite, StringFormat='dd.MM.yyyy HH:mm'}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="6" Text="Стан" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding StateText}" HorizontalAlignment="Right" TextWrapping="Wrap" TextAlignment="Right"
                                               Foreground="{Binding State, Converter={StaticResource SevBrush}}"/>
                                    <TextBlock Grid.Row="7" Text="Сесія" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding MountedBy}" TextWrapping="Wrap" TextAlignment="Right" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="8" Text="Інформацію оновлено" Foreground="{StaticResource Muted}" Margin="0,8,12,2"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding RefreshedText}" HorizontalAlignment="Right" Margin="0,8,0,2"
                                               ToolTip="Розмір, дата, макс. розмір, стан підключення, обліковий запис"/>
                                    <TextBlock Grid.Row="9" Text="Аналіз тому" Foreground="{StaticResource Muted}" Margin="0,2,12,2"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding AnalyzedText}" HorizontalAlignment="Right"
                                               ToolTip="Коли востаннє вимірювалось «Зайнято в томі» (Аналізувати / Очистити)"/>
                                    <TextBlock Grid.Row="10" Text="Обліковий запис (AD)" Foreground="{StaticResource Muted}" Margin="0,2,12,2"
                                               ToolTip="Стан в Active Directory та lastLogonTimestamp (реплікується із затримкою до ~14 днів)"/>
                                    <TextBlock Grid.Row="10" Grid.Column="1" HorizontalAlignment="Right" Text="{Binding AdText}" TextWrapping="Wrap" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- size history -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding Spark, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="Історія розміру" Style="{StaticResource MutedText}"/>
                                    <TextBlock HorizontalAlignment="Right" FontSize="12" ToolTip="{Binding GrowthSpanText}">
                                        <Run Text="{Binding GrowthText, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{Binding GrowthSpanDays, Mode=OneWay, StringFormat=' за {0} дн.'}" Foreground="{StaticResource Muted}"/>
                                    </TextBlock>
                                </DockPanel>
                                <Viewbox Stretch="Uniform" Margin="0,8,0,6">
                                    <Grid Width="300" Height="48">
                                        <Polyline Points="{Binding Spark}" Stroke="{StaticResource Accent}" StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"/>
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="{Binding SparkCaption}" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock x:Name="sparkEta" Text="{Binding EtaText}" FontSize="12" Margin="0,4,0,0"
                                           Visibility="{Binding EtaText, Converter={StaticResource Vis}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EtaSoon}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Crit}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- operation progress -->
                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" BorderBrush="{StaticResource Accent}"
                                Visibility="{Binding IsBusy, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding BusyPercentText}" DockPanel.Dock="Right" FontSize="22" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding BusyOp}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Busy}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Background="{StaticResource Track}" CornerRadius="4" Height="8" Margin="0,10,0,8" ClipToBounds="True">
                                    <Border Background="{StaticResource Accent}" CornerRadius="4" RenderTransformOrigin="0,0">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding BusyPercent, Converter={StaticResource Scale}}"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                                <TextBlock Text="{Binding BusyDetail}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11.5"
                                           Visibility="{Binding BusyDetail, Converter={StaticResource Vis}}"/>
                                <DockPanel Margin="0,8,0,0">
                                    <Button Content="Скасувати" DockPanel.Dock="Right" Padding="12,4"
                                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                    <TextBlock Text="{Binding BusyElapsed, StringFormat='{}Минуло: {0}'}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- actions -->
                        <TextBlock Text="ДІЇ" Style="{StaticResource SectionTitle}" Margin="0,18,0,8"/>
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Visibility="{Binding CheckedCount, Converter={StaticResource Vis}}"
                                   Text="{Binding CheckedCount, StringFormat='{}Дії застосуються до позначених контейнерів: {0}'}"/>
                        <UniformGrid Columns="2" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Button Content="Виміряти" Padding="6,7" Margin="0,0,4,8" Command="{Binding MeasureCommand}"
                                    ToolTip="Швидко (кілька секунд, лише читання): точне заповнення, скільки поверне стиснення, стан ФС. Кілька позначених — до 4 одночасно"/>
                            <Button Content="Аналізувати" Padding="6,7" Margin="4,0,0,8" Command="{Binding AnalyzeCommand}"
                                    ToolTip="Лише читання: те саме, що «Виміряти», плюс найбільші папки й файли та скільки звільнять правила (довше). Кілька позначених — до 3 одночасно"/>
                            <Button Content="Очистити" Padding="6,7" Style="{StaticResource PrimaryButton}" Margin="0,0,4,8" Command="{Binding CleanCommand}"
                                    ToolTip="Видалити дані за правилами (і стиснути, якщо увімкнено)"/>
                            <Button Content="Стиснути" Padding="6,7" Margin="4,0,0,8" Command="{Binding CompactCommand}"
                                    ToolTip="Повернути вільне місце з VHDX на диск сервера"/>
                            <Button Content="Збільшити розмір" Padding="6,7" Margin="0,0,4,8" Command="{Binding GrowCommand}"
                                    ToolTip="Збільшити максимальний розмір VHDX і розширити розділ усередині (Hyper-V не потрібен)"/>
                            <Button Content="Перевірити ФС" Padding="6,7" Margin="4,0,0,8" Command="{Binding RepairFsCommand}"
                                    ToolTip="Перевірити й виправити NTFS усередині контейнера (аналог chkdsk /f)"/>
                        </UniformGrid>
                        <Button Content="Відмонтувати" Padding="6,7" Style="{StaticResource DangerButton}" Margin="0,0,0,8"
                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding UnmountCommand}"
                                ToolTip="Примусово закрити SMB-сесію або відключити локально підключений диск"/>

                        <!-- RDS session of the user (container open over SMB by a session host) -->
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding Selected.HasSessionHost, Converter={StaticResource Vis}}">
                            <TextBlock Text="СЕАНС НА RDS-ХОСТІ" Style="{StaticResource SectionTitle}" Margin="0,10,0,8"/>
                            <UniformGrid Columns="2">
                                <Button Content="Повідомлення…" Padding="6,7" Margin="0,0,4,8" Command="{Binding MessageCommand}"
                                        ToolTip="Надіслати повідомлення в сеанс користувача (наприклад, попросити вийти із системи)"/>
                                <Button Content="Завершити сеанс" Padding="6,7" Style="{StaticResource DangerButton}" Margin="4,0,0,8" Command="{Binding LogoffCommand}"
                                        ToolTip="Вийти з сеансу користувача на хості — FSLogix коректно відключить профіль"/>
                            </UniformGrid>
                        </StackPanel>
                        <Button Content="Показати у провіднику" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                Command="{Binding OpenFolderCommand}"/>

                        <!-- delete: shown when a stale container is targeted, enabled only if ALL targets are stale -->
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Visibility="{Binding ShowDelete, Converter={StaticResource Vis}}" Margin="0,8,0,0">
                            <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}"
                                    ToolTip="{Binding DeleteHint}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" Margin="0,0,8,0" Foreground="#FFB4B0"/>
                                    <TextBlock Text="{Binding DeleteLabel}" Foreground="#FFB4B0"/>
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding DeleteHint}" Style="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="11.5" Margin="0,6,0,0"
                                       Visibility="{Binding DeleteBlocked, Converter={StaticResource Vis}}" Foreground="{StaticResource Warn}"/>
                        </StackPanel>

                        <Border Background="{StaticResource Surface2}" CornerRadius="7" Padding="10" Margin="0,12,0,0"
                                Visibility="{Binding LastResult, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>

                        <!-- estimates -->
                        <StackPanel Visibility="{Binding Estimates, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="МОЖНА ЗВІЛЬНИТИ" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="{Binding EstimateTotalText}" HorizontalAlignment="Right" Foreground="{StaticResource Ok}" FontWeight="SemiBold"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Estimates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,3">
                                            <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                            <TextBlock Text="{Binding RuleName}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- top folders -->
                        <StackPanel Visibility="{Binding TopFolders, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                            <TextBlock Text="НАЙБІЛЬШІ ПАПКИ (≥ 100 MB)" Style="{StaticResource SectionTitle}"/>

                            <!-- breadcrumbs: ← Огляд › AppData › Local › Microsoft -->
                            <DockPanel Margin="0,0,0,6" Visibility="{Binding IsDrilled, Converter={StaticResource Vis}}">
                                <Button Content="←" DockPanel.Dock="Left" Style="{StaticResource GhostButton}" FontSize="14" Padding="6,0" Margin="0,0,4,0"
                                        ToolTip="На рівень вище"
                                        Command="{Binding DataContext.DrillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="up"/>
                                <ItemsControl ItemsSource="{Binding Crumbs}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="{Binding Name}" Style="{StaticResource GhostButton}" Padding="3,1" FontSize="12"
                                                        Foreground="{StaticResource Accent}"
                                                        Command="{Binding DataContext.DrillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="›" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="1,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding TopFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button x:Name="row" Command="{Binding DataContext.DrillCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" Cursor="Arrow" Margin="-6,0" Padding="6,4"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="{StaticResource Hover}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock x:Name="chev" Text="›" DockPanel.Dock="Right" Width="12" TextAlignment="Right" FontSize="14"
                                                               Foreground="{StaticResource Accent}" Visibility="Hidden" Margin="6,-2,0,0"/>
                                                    <Button x:Name="del" DockPanel.Dock="Right" Content="🗑" FontSize="11" Padding="5,0" Margin="6,-2,0,-2"
                                                            Visibility="Collapsed" Cursor="Hand" ToolTip="Видалити цю папку з контейнера"
                                                            Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{StaticResource Muted}"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="b" Property="Background" Value="#3A1D1F"/>
                                                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource Crit}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="b" Property="Opacity" Value="0.3"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                                    <TextBlock x:Name="name" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                                </DockPanel>
                                                <Border x:Name="bar" Style="{StaticResource BarTrack}" Height="4" Margin="0,3,0,0">
                                                    <Border Background="{StaticResource Accent}" CornerRadius="2" RenderTransformOrigin="0,0">
                                                        <Border.RenderTransform>
                                                            <ScaleTransform ScaleX="{Binding Fraction, Converter={StaticResource Scale}, ConverterParameter=1}"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding CanDrill}" Value="True">
                                                <Setter TargetName="row" Property="Cursor" Value="Hand"/>
                                                <Setter TargetName="row" Property="ToolTip" Value="Переглянути вкладені папки"/>
                                                <Setter TargetName="chev" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanDelete}" Value="True">
                                                <Setter TargetName="del" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                                <Setter TargetName="row" Property="IsHitTestVisible" Value="False"/>
                                                <Setter TargetName="name" Property="Foreground" Value="{StaticResource Muted}"/>
                                                <Setter TargetName="bar" Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- top files -->
                        <StackPanel Visibility="{Binding TopFiles, Converter={StaticResource Vis}}" Margin="0,18,0,0">
                            <TextBlock Text="НАЙБІЛЬШІ ФАЙЛИ (≥ 100 MB)" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl ItemsSource="{Binding TopFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4" ToolTip="{Binding Path}">
                                            <DockPanel>
                                                <!-- delete this file from the container (same look as the folder rows; disabled for globalExclude) -->
                                                <Button DockPanel.Dock="Right" Content="🗑" FontSize="11" Padding="5,0" Margin="6,-2,-6,-2" Cursor="Hand"
                                                        ToolTip="Видалити цей файл з контейнера"
                                                        Command="{Binding DataContext.DeleteFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="b" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                <TextBlock x:Name="t" Text="{TemplateBinding Content}" Foreground="{StaticResource Muted}"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="#3A1D1F"/>
                                                                    <Setter TargetName="t" Property="Foreground" Value="{StaticResource Crit}"/>
                                                                </Trigger>
                                                                <Trigger Property="IsEnabled" Value="False">
                                                                    <Setter TargetName="b" Property="Opacity" Value="0.3"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                                <TextBlock Text="{Binding SizeText}" DockPanel.Dock="Right" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding ModifiedText}" DockPanel.Dock="Right" Style="{StaticResource MutedText}" FontSize="11" Margin="8,0,0,0"/>
                                                <TextBlock Text="{Binding Folder}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <Border Style="{StaticResource BarTrack}" Height="4" Margin="0,3,0,0">
                                                <Border Background="{StaticResource Accent}" CornerRadius="2" RenderTransformOrigin="0,0">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="{Binding Fraction, Converter={StaticResource Scale}, ConverterParameter=1}"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═════════════════════════ LOG ═════════════════════════ -->
        <Expander Grid.Row="1" Grid.ColumnSpan="3" IsExpanded="False" Background="{StaticResource Surface}"
                  BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Foreground="{StaticResource Muted}" Padding="12,4">
            <Expander.Header>
                <TextBlock Text="Журнал операцій" Foreground="{StaticResource Muted}" FontSize="12"/>
            </Expander.Header>
            <ListBox ItemsSource="{Binding LogLines}" Height="170" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" TextWrapping="Wrap" Margin="0,1">
                            <Run Text="{Binding Time, StringFormat='HH:mm:ss', Mode=OneWay}" Foreground="{StaticResource Muted}"/>
                            <Run Text="{Binding Level, Mode=OneWay}" x:Name="lvl" Foreground="{StaticResource Accent}"/>
                            <Run Text="{Binding Text, Mode=OneWay}"/>
                        </TextBlock>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Level}" Value="WARN">
                                <Setter TargetName="lvl" Property="Foreground" Value="{StaticResource Warn}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Level}" Value="ERROR">
                                <Setter TargetName="lvl" Property="Foreground" Value="{StaticResource Crit}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>

        <!-- status bar -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
            <Grid Height="28" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" VerticalAlignment="Center" Value="{Binding Progress}"
                             IsIndeterminate="{Binding IsScanning}"
                             Visibility="{Binding IsIdle, Converter={StaticResource Vis}, ConverterParameter=!}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
